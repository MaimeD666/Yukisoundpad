<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Изменить звук" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="10">
  <TextBlock Text="Название" Margin="0,0,0,3"/><TextBox x:Name="SoundName" MaxLength="80"/>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4" Margin="0,10,0,3"><Grid x:Name="WaveHost" Height="76"/></Border>
  <TextBlock Text="Перетащите границы выделения или укажите время." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Начало, сек." Margin="0,0,0,3"/><TextBox x:Name="Start"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Конец, сек." Margin="0,0,0,3"/><TextBox x:Name="End"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="Preview" Content="Прослушать"/><Button x:Name="StopPreview" Content="Стоп" Margin="4,0,0,0"/></StackPanel></Grid>
  <TextBlock x:Name="SelectionLength" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Коллекция" Margin="0,0,0,3"/><TextBox x:Name="Collection" MaxLength="40"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Горячая клавиша" Margin="0,0,0,3"/><DockPanel><Button x:Name="ClearHotkey" Content="×" DockPanel.Dock="Right" Width="26" Margin="4,0,0,0" Padding="0" ToolTip="Убрать сочетание"/><TextBox x:Name="Hotkey" IsReadOnly="True" ToolTip="Нажмите Ctrl / Alt с клавишей или F1–F12"/></DockPanel></StackPanel></Grid>
  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock x:Name="GainLabel"/><Slider x:Name="Gain" Minimum="0" Maximum="100" Value="100"/></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="Loop" Content="Повторять"/><CheckBox x:Name="Favorite" Content="Избранное"/></StackPanel></Grid>
  <TextBlock x:Name="Error" Foreground="#AD2020" TextWrapping="Wrap" Margin="0,4,0,4"/>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Cancel" Content="Отмена" MinWidth="75" Margin="0,0,6,0" IsCancel="True"/><Button x:Name="Save" Content="Сохранить" MinWidth="85" IsDefault="True"/></StackPanel><StackPanel Orientation="Horizontal"><Button x:Name="Delete" Content="Удалить" Margin="0,0,6,0"/><Button x:Name="Export" Content="Экспорт WAV…"/></StackPanel></DockPanel></Border>
 </StackPanel>
</Window>
