<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yuki’s Pad" Width="730" Height="440" MinWidth="630" MinHeight="360" WindowStartupLocation="CenterScreen" AllowDrop="True">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6"><Button x:Name="Settings" Content="Настройки" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Button x:Name="Import" Content="Добавить…" ToolTip="Добавить аудио (Ctrl+O)"/><Button x:Name="Stop" Content="Стоп" Margin="6,0,0,0" ToolTip="Остановить звук (Ctrl+Alt+Space)"/><Button x:Name="EditSelected" Content="Изменить…" Margin="6,0,0,0" ToolTip="Обрезка, название и горячая клавиша"/><Button x:Name="Guide" Content="Подключение" Visibility="Collapsed"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" ToolTip="Поиск по названию или коллекции (Ctrl+F)"/><TextBlock x:Name="SearchHint" Text="Поиск" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/></Grid><ComboBox x:Name="Sort" Grid.Column="1" Margin="6,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Сначала новые"/><ComboBoxItem Content="По названию"/><ComboBoxItem Content="По длительности"/></ComboBox></Grid>
  <DockPanel Grid.Row="2" Margin="0,0,0,6"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="AllSounds" Content="Все"/><Button x:Name="Favorites" Content="Избранное" Margin="4,0,4,0"/></StackPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Collections" Orientation="Horizontal"/></ScrollViewer></DockPanel>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" Background="#E6E6E6"><Grid Margin="7,0,21,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="48"/><ColumnDefinition Width="110"/><ColumnDefinition Width="91"/></Grid.ColumnDefinitions><TextBlock Text="Название" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Коллекция" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Время" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Клавиша" VerticalAlignment="Center"/></Grid></Border>
   <ListBox x:Name="Sounds" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" KeyboardNavigation.TabNavigation="Once"><ListBox.ItemTemplate><DataTemplate><Grid Height="30" Margin="6,0,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="48"/><ColumnDefinition Width="110"/><ColumnDefinition Width="91"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Grid.Column="1" Text="{Binding Collection}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Collection}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Grid.Column="2" Text="{Binding LengthText}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding HotkeyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="▶" Tag="play" Width="28" Padding="0" MinHeight="23" ToolTip="Воспроизвести / остановить"/><Button Content="{Binding FavoriteIcon}" Tag="favorite" Width="28" Padding="0" MinHeight="23" Margin="2,0" ToolTip="Избранное"/><Button Content="…" Tag="edit" Width="28" Padding="0" MinHeight="23" ToolTip="Изменить звук"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Border x:Name="Empty" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="Нет звуков" TextAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Добавьте аудиофайлы." TextAlignment="Center" Margin="0,5,0,8" Foreground="{StaticResource Muted}"/><Button x:Name="EmptyImport" Content="Добавить…" HorizontalAlignment="Center"/></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,4,0,4"><StackPanel x:Name="Pagination" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="PreviousPage" Content="‹" Padding="6,0" MinHeight="22"/><TextBlock x:Name="PageNumber" VerticalAlignment="Center" Margin="6,0"/><Button x:Name="NextPage" Content="›" Padding="6,0" MinHeight="22"/></StackPanel><TextBlock x:Name="Count" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="PageTitle" Visibility="Collapsed"/></DockPanel>
  <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="PlayingName" Text="Не воспроизводится" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,3,0,0"><TextBlock x:Name="PlayingTime" Text="—" DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="6" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Громкость" VerticalAlignment="Center" Margin="0,0,5,0"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Width="100"/><TextBlock x:Name="VolumeLabel" Text="80%" Width="32" TextAlignment="Right" VerticalAlignment="Center"/><Button x:Name="Mic" Content="В микрофон" Margin="10,0,0,0" Width="112"/></StackPanel></Grid></Border>
  <Grid Grid.Row="6" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Готово" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Route" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Right"/></Grid>
 </Grid>
</Window>
