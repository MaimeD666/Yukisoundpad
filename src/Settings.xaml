<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки" Width="510" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="10">
  <TextBlock Text="Микрофон" Margin="0,0,0,3"/><ComboBox x:Name="Microphone" DisplayMemberPath="DisplayName"/>
  <TextBlock x:Name="Connection" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,6"/>
  <StackPanel Orientation="Horizontal"><Button x:Name="Connect" Content="Подключить и проверить"/><Button x:Name="Disconnect" Content="Отключить" Margin="6,0,0,0"/><Button x:Name="Refresh" Content="Обновить" Margin="6,0,0,0"/></StackPanel>
  <CheckBox x:Name="Send" Content="Отправлять звуки в микрофон" Margin="0,12,0,4"/>
  <CheckBox x:Name="Monitoring" Content="Слышать звуки у себя"/>
  <ComboBox x:Name="Monitor" DisplayMemberPath="Name" Margin="0,3,0,6"/>
  <CheckBox x:Name="Tray" Content="При закрытии сворачивать в трей"/>
  <GroupBox Header="Discord" Margin="0,8,0,0" Padding="6"><TextBlock Text="Выберите в Discord тот же микрофон. Если музыка обрезается, отключите шумоподавление. При Push-to-talk удерживайте клавишу разговора и для звуков." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></GroupBox>
  <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#AD2020" Margin="0,6,0,6"/>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Отмена" MinWidth="75" Margin="0,0,6,0" IsCancel="True"/><Button x:Name="Save" Content="Сохранить" MinWidth="85" IsDefault="True"/></StackPanel></Border>
 </StackPanel>
</Window>
